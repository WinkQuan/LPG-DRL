<?xml version="1.0"?>
<sdf version="1.7">
	<world name="off-road_world">
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>
		<!-- 地形场景 -->
		<include>
			<name>myterrain</name>
			<pose>214 38 27.5 0 0 0</pose>
			<uri>model://myterrain</uri>
		</include>
		<!-- 围墙 -->
		<include>
			<name>high_wall</name>
			<pose>0 0 0 0 0 0</pose>
			<uri>model://high_wall</uri>
		</include>
		<!-- 目标点 -->
		<include>
			<name>unit_box_real</name>
			<pose>0 -13 -22.54 0 0 0</pose>
			<uri>model://unit_box_real</uri>
		</include>
		<!-- 小车模型 -->
		<include>
			<name>mycar</name>
			<pose>0 13 3 0 0 -1.57</pose>
			<uri>model://mycar</uri>
		</include>
		<!-- Fixed top-down camera for recording overhead validation videos. -->
		<include>
			<name>top_down_camera</name>
			<pose>0 0 80 0 1.57079632679 0</pose>
			<uri>model://top_down_camera</uri>
		</include>
		<!-- 目标点：一颗树 -->
		<include>
			<name>Oak tree</name>
			<pose>0 -13 2 0 0 0</pose>
			<uri>model://Oak tree</uri>
		</include>
	</world>
</sdf>
