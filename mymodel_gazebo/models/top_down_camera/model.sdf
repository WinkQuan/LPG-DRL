<?xml version="1.0"?>
<sdf version="1.7">
  <model name="top_down_camera">
    <static>true</static>
    <link name="camera_link">
      <pose>0 0 0 0 0 0</pose>
      <sensor name="top_down_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <camera name="top_down_camera">
          <horizontal_fov>0.40728849</horizontal_fov>
          <image>
            <width>3000</width>
            <height>1508</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200</far>
          </clip>
        </camera>
        <plugin name="top_down_camera_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>top_down_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>top_down_camera_link</frameName>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
